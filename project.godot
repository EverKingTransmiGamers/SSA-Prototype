; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StickSpyMan Adventures-Dev"
config/description="Development Version of my Platform and Building Game"
config/version="Alpha 1.2.5"
config/tags=PackedStringArray("4.6.3", "prototype")
run/main_scene="uid://clitis128xofo"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://draa1i8snn4tc"

[autoload]

ObjectsManager1K="*res://Scripts/Autoloads/ObjectsManager1K.gd"
SettingsManager1K="*res://Scripts/Autoloads/SettingsManager1K.gd"
LevelsManager="*res://Scripts/Autoloads/LevelsManager.gd"

[display]

window/size/viewport_width=1056
window/size/viewport_height=594
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://My Levels/": "green",
"res://Scenes/": "blue",
"res://Scripts/": "orange"
}

[global_group]

Player=""
Enemy=""
Level="Game Levels"
Level_Warp=""

